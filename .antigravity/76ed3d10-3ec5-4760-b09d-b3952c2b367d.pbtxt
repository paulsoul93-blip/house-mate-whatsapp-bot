    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ScreenType } from \'../App\';\n\nexport default function DashboardScreen({ onNavigate }: { onNavigate: (screen: ScreenType) => void }) {\n    const [isLive, setIsLive] = useState(true);\n\n    return (\n        <div className=\"bg-background font-body-md text-on-surface min-h-screen flex overflow-x-hidden relative\">\n            {/* Grain Aesthetic Overlay */}\n            <div className=\"fixed inset-0 grain-overlay z-[60]\"></div>\n\n            {/* SideNavBar */}\n            <aside className=\"h-full w-64 fixed left-0 top-0 z-40 bg-jungle-deep flex-col py-8 shadow-xl hidden md:flex\">\n                <div className=\"px-6 mb-10\">\n                    <h1 \n                        className=\"font-headline-md text-headline-md text-secondary-fixed cursor-pointer\"\n                        onClick={() => onNavigate(\'landing\')}\n                    >\n                        Creator Studio\n                    </h1>\n                    <p className=\"text-on-secondary-fixed-variant opacity-70 text-sm\">dziubki_explore admin</p>\n                </div>\n                <nav className=\"flex-1 space-y-1\">\n                    <a onClick={(e) => { e.preventDefault(); onNavigate(\'dashboard\'); }} className=\"cursor-pointer bg-leaf-green text-secondary-fixed rounded-xl mx-2 my-1 flex items-center px-4 py-3 translate-x-1 duration-150 group\">\n                        <span className=\"material-symbols-outlined mr-3\">dashboard</span>\n                        <span className=\"font-body-md text-body-md\">Dashboard</span>\n                    </a>\n                    <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer text-on-secondary-fixed-variant hover:text-secondary-fixed px-4 py-3 mx-2 flex items-center transition-all hover:bg-leaf-green/20 rounded-xl group\">\n                        <span className=\"material-symbols-outlined mr-3 opacity-70 group-hover:opacity-100\">map</span>\n                        <span className=\"font-body-md text-body-md\">Map Editor</span>\n                    </a>\n                    <a onClick={(e) => { e.preventDefault(); onNavigate(\'gallery\'); }} className=\"cursor-pointer text-on-secondary-fixed-variant hover:text-secondary-fixed px-4 py-3 mx-2 flex items-center transition-all hover:bg-leaf-green/20 rounded-xl group\">\n                        <span className=\"material-symbols-outlined mr-3 opacity-70 group-hover:opacity-100\">auto_stories</span>\n                        <span className=\"font-body-md text-body-md\">Content Manager</span>\n                    </a>\n                    <a onClick={(e) => { e.preventDefault(); onNavigate(\'profiles\'); }} className=\"cursor-pointer text-on-secondary-fixed-variant hover:text-secondary-fixed px-4 py-3 mx-2 flex items-center transition-all hover:bg-leaf-green/20 rounded-xl group\">\n                        <span className=\"material-symbols-outlined mr-3 opacity-70 group-hover:opacity-100\">volunteer_activism</span>\n                        <span className=\"font-body-md text-body-md\">Patron Stats</span>\n                    </a>\n                    <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer text-on-secondary-fixed-variant hover:text-secondary-fixed px-4 py-3 mx-2 flex items-center transition-all hover:bg-leaf-green/20 rounded-xl group\">\n                        <span className=\"material-symbols-outlined mr-3 opacity-70 group-hover:opacity-100\">analytics</span>\n                        <span className=\"font-body-md text-body-md\">Analytics</span>\n                    </a>\n                </nav>\n                <div className=\"px-4 mt-auto\">\n                    <button onClick={() => onNavigate(\'live\')} className=\"w-full bg-coral-sunrise text-white font-bold py-3 rounded-full shadow-[0_0_15px_rgba(255,127,80,0.5)] hover:scale-105 transition-transform uppercase tracking-wider text-sm\">\n                        Go Live Now\n                    </button>\n                </div>\n            </aside>\n\n            {/* Main Content Canvas */}\n            <main className=\"flex-1 md:ml-64 p-6 md:p-12 max-w-container-max mx-auto w-full relative z-10\">\n                {/* Header Area */}\n                <header className=\"flex justify-between items-center mb-10\">\n                    <div>\n                        <h2 className=\"font-headline-lg text-headline-lg text-primary tracking-tight\">Adventure Control</h2>\n                        <p className=\"text-on-surface-variant font-body-md\">Welcome back, Mateusz and Magda.</p>\n                    </div>\n                    <div className=\"flex items-center gap-4\">\n                        <div className=\"glass-card px-4 py-2 rounded-full flex items-center gap-3\">\n                            <span className=\"relative flex h-3 w-3\">\n                                {isLive && <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-error opacity-75\"></span>}\n                                <span className={`relative inline-flex rounded-full h-3 w-3 ${isLive ? \'bg-error\' : \'bg-outline-variant\'}`}></span>\n                            </span>\n                            <span className=\"font-label-sm text-label-sm uppercase text-on-surface-variant\">System Online</span>\n                            <div onClick={() => setIsLive(!isLive)} className={`w-10 h-5 rounded-full relative cursor-pointer shadow-inner transition-colors ${isLive ? \'bg-leaf-green\' : \'bg-outline-variant\'}`}>\n                                <div className={`absolute top-0.5 w-4 h-4 bg-white rounded-full transition-transform ${isLive ? \'right-0.5\' : \'right-0.5 -translate-x-[20px]\'}`}></div>\n                            </div>\n                        </div>\n                        <div className=\"relative group\">\n                            <img alt=\"Mateusz and Magda\" className=\"w-12 h-12 rounded-full border-2 border-leaf-green object-cover\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBolmVpmxjBnDyObIaOOZKLfPpOLVGvjrqcQfIYQEmoQvuqUi5h1PKocnA5aU_ddD1kohekl0-QS_JHSwUXMJaMXeKCBEKNt1Bt-ODpWWDzF2dyWGXno0YUl0TuLpyhxIaFjr0oWXT54icYp3V9I2n4xV7sRSry-xyjOplMcXOzoh0ZTCd1Gt-hw2Ghn3n5p6l86stjD91y9n7SltORjQ0tYgK-osBzKmFOtW9A3PHN0_5ZJuwjr9Fy0965Wan2coKOTTVlX-xL1co\"/>\n                        </div>\n                    </div>\n                </header>\n\n                {/* Dashboard Bento Grid */}\n                <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n                    {/* Add New Adventure Form */}\n                    <section className=\"lg:col-span-8 bg-surface-container-lowest rounded-[24px] p-8 shadow-sm border border-outline-variant/20 relative overflow-hidden transition-transform duration-300 hover:-translate-y-1\">\n                        <div className=\"absolute top-[-20px] right-[-20px] opacity-[0.03] rotate-12 pointer-events-none\">\n                            <span className=\"material-symbols-outlined text-[160px]\">explore</span>\n                        </div>\n                        <h3 className=\"font-headline-md text-headline-md text-leaf-green mb-6 flex items-center gap-2\">\n                            <span className=\"material-symbols-outlined\">add_circle</span> New Adventure\n                        </h3>\n                        <form className=\"space-y-6 relative z-10\" onSubmit={(e) => e.preventDefault()}>\n                            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                                <div className=\"space-y-2\">\n                                    <label className=\"font-label-sm text-label-sm text-on-surface-variant px-1\">JOURNEY TITLE</label>\n                                    <input className=\"w-full bg-surface-container-low border-none rounded-full px-6 py-3 focus:ring-2 focus:ring-leaf-green transition-all\" placeholder=\"e.g. Amazon Deep Expedition\" type=\"text\"/>\n                                </div>\n                                <div className=\"space-y-2\">\n                                    <label className=\"font-label-sm text-label-sm text-on-surface-variant px-1\">LOCATION TAG</label>\n                                    <div className=\"relative\">\n                                        <input className=\"w-full bg-surface-container-low border-none rounded-full pl-12 pr-6 py-3 focus:ring-2 focus:ring-leaf-green transition-all\" placeholder=\"Search coordinates...\" type=\"text\"/>\n                                        <span className=\"material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant\">location_on</span>\n                                    </div>\n                                </div>\n                            </div>\n                            <div className=\"space-y-2\">\n                                <label className=\"font-label-sm text-label-sm text-on-surface-variant px-1\">EXPEDITION BRIEF</label>\n                                <textarea className=\"w-full bg-surface-container-low border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-leaf-green transition-all resize-none\" placeholder=\"Describe the raw experience...\" rows={3}></textarea>\n                            </div>\n                            <div className=\"flex items-center justify-between pt-4\">\n                                <div className=\"flex gap-2\">\n                                    <button className=\"p-3 rounded-full bg-surface-container-high text-on-surface-variant hover:bg-leaf-green/10 transition-colors\" type=\"button\"><span className=\"material-symbols-outlined\">image</span></button>\n                                    <button className=\"p-3 rounded-full bg-surface-container-high text-on-surface-variant hover:bg-leaf-green/10 transition-colors\" type=\"button\"><span className=\"material-symbols-outlined\">videocam</span></button>\n                                    <button className=\"p-3 rounded-full bg-surface-container-high text-on-surface-variant hover:bg-leaf-green/10 transition-colors\" type=\"button\"><span className=\"material-symbols-outlined\">mic</span></button>\n                                </div>\n                                <button className=\"bg-primary-container text-secondary-fixed-dim px-8 py-3 rounded-full font-bold uppercase tracking-widest hover:bg-jungle-deep transition-all shadow-lg active:scale-95\" type=\"submit\">\n                                    Publish Journey\n                                </button>\n                            </div>\n                        </form>\n                    </section>\n\n                    {/* Stats */}\n                    <section className=\"lg:col-span-4 space-y-6\">\n                        <div className=\"bg-jungle-deep rounded-[24px] p-8 text-secondary-fixed shadow-xl relative overflow-hidden group\">\n                            <div className=\"absolute inset-0 bg-gradient-to-br from-leaf-green/20 to-transparent opacity-50\"></div>\n                            <div className=\"relative z-10\">\n                                <div className=\"flex justify-between items-start mb-8\">\n                                    <div>\n                                        <p className=\"font-label-sm text-label-sm text-secondary-fixed-dim opacity-70\">ACTIVE PATRONS</p>\n                                        <h4 className=\"font-display-lg text-[48px] font-extrabold leading-none mt-1\">1,482</h4>\n                                    </div>\n                                    <div className=\"bg-leaf-green/30 p-2 rounded-xl\">\n                                        <span className=\"material-symbols-outlined text-secondary-fixed\">trending_up</span>\n                                    </div>\n                                </div>\n                                <div className=\"space-y-3\">\n                                    <div className=\"flex justify-between text-xs font-bold uppercase tracking-tighter opacity-80\">\n                                        <span>Monthly Goal</span>\n                                        <span>85%</span>\n                                    </div>\n                                    <div className=\"h-3 w-full bg-primary-container rounded-full overflow-hidden\">\n                                        <div className=\"h-full bg-coral-sunrise rounded-full shadow-[0_0_10px_rgba(255,127,80,0.6)]\" style={{ width: \'85%\' }}></div>\n                                    </div>\n                                    <p className=\"text-[10px] italic opacity-60 text-right\">Target: 1,750 adventurers</p>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div className=\"bg-surface-container-lowest border border-outline-variant/20 rounded-[24px] p-6 shadow-sm flex items-center justify-between group cursor-pointer hover:bg-sand-surface transition-colors\">\n                            <div className=\"flex items-center gap-4\">\n                                <div className=\"bg-tertiary-fixed p-3 rounded-2xl text-on-tertiary-fixed-variant\">\n                                    <span className=\"material-symbols-outlined\">analytics</span>\n                                </div>\n                                <div>\n                                    <p className=\"font-bold text-on-surface\">Weekly Report</p>\n                                    <p className=\"text-xs text-on-surface-variant\">Engagement is up 12%</p>\n                                </div>\n                            </div>\n                            <span className=\"material-symbols-outlined text-outline group-hover:translate-x-1 transition-transform\">chevron_right</span>\n                        </div>\n                    </section>\n\n                    {/* Activity Feed */}\n                    <section className=\"lg:col-span-8 bg-surface-container-lowest rounded-[24px] p-8 shadow-sm border border-outline-variant/20 transition-transform duration-300 hover:-translate-y-1\">\n                        <div className=\"flex justify-between items-center mb-8\">\n                            <h3 className=\"font-headline-md text-headline-md text-primary\">Recent Activity</h3>\n                            <button className=\"text-leaf-green font-bold text-sm hover:underline\">View All</button>\n                        </div>\n                        <div className=\"space-y-6\">\n                            <div className=\"flex gap-4 items-start group\">\n                                <div className=\"w-12 h-12 rounded-2xl overflow-hidden shrink-0 border border-outline-variant/30\">\n                                    <img alt=\"Lost Valley\" className=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCjZl5-W4hzKTbXrOfAzrCYfnx65wzCSFlKUK5wdqcx8Vh0FOv37X_Br2842HnBFqqhzywdmc3kW4ohNAdnpwUr0FktWd0U44BDRMNx14Y50FQM5llz6yQ1Y1Pxg6v6RQKdnka2Lg51OZMpzKjireM7ha2uOTqLuRbFHf87M2vZkzat8QfPpGgrdY02XpUK2lcFFnKfWyKYSj3CPOKBtIFlItjnfiDZbV9TTsdYGDfCl0XzXgz9y2X4Hb0j6skM5c0tBw-EHxWFPGs\"/>\n                                </div>\n                                <div className=\"flex-1 border-b border-outline-variant/10 pb-4\">\n                                    <div className=\"flex justify-between mb-1\">\n                                        <h5 className=\"font-bold text-on-surface\">Expedition: \'Lost Valley\' Live</h5>\n                                        <span className=\"text-xs text-on-surface-variant\">2h ago</span>\n                                    </div>\n                                    <p className=\"text-sm text-on-surface-variant leading-relaxed\">The live stream recorded 4.2k concurrent viewers and 128 new patron signups during the bridge crossing.</p>\n                                </div>\n                            </div>\n                            <div className=\"flex gap-4 items-start group\">\n                                <div className=\"w-12 h-12 rounded-2xl bg-secondary-container flex items-center justify-center shrink-0\">\n                                    <span className=\"material-symbols-outlined text-on-secondary-container\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>volunteer_activism</span>\n                                </div>\n                                <div className=\"flex-1 border-b border-outline-variant/10 pb-4\">\n                                    <div className=\"flex justify-between mb-1\">\n                                        <h5 className=\"font-bold text-on-surface\">Top Patron Milestone</h5>\n                                        <span className=\"text-xs text-on-surface-variant\">5h ago</span>\n                                    </div>\n                                    <p className=\"text-sm text-on-surface-variant leading-relaxed\">User <span className=\"text-leaf-green font-semibold\">@trail_seeker</span> just reached \'Elite Explorer\' status with their 12th consecutive month of support.</p>\n                                </div>\n                            </div>\n                            <div className=\"flex gap-4 items-start group\">\n                                <div className=\"w-12 h-12 rounded-2xl overflow-hidden shrink-0 border border-outline-variant/30\">\n                                    <img alt=\"Gallery Amazon\" className=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDcu6MifEpuCXeTHqZaOvh7nH9W1CpmXLVK5UoKiZjRW_EOP2701NCgKNDHMOQ7PG2tlbh-Bqugq9CRSSLOhVV-kUXDZCHRaBBOhR2F3oX7-1BlGa962qZTqtx56ArcYNN2tgaQNVAUjebtI_4ltLacQSWidwZj1drR-Ofjyn9kluy2TLUmwHkEBwBNhQrAYDbMT2wcDTwxJSeq44pRuMMzNsWmg9viSdNVNBY4DPu9OxKWXArdpMvouPOiWhf4lMNckX2MkVm3Etc\"/>\n                                </div>\n                                <div className=\"flex-1 pb-2\">\n                                    <div className=\"flex justify-between mb-1\">\n                                        <h5 className=\"font-bold text-on-surface\">Gallery Update: Amazon 2024</h5>\n                                        <span className=\"text-xs text-on-surface-variant\">Yesterday</span>\n                                    </div>\n                                    <p className=\"text-sm text-on-surface-variant leading-relaxed\">45 new high-resolution organic captures were added to the \'Amazon Jungle\' collection.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n\n                    {/* Media Library Peek */}\n                    <section className=\"lg:col-span-4 bg-surface-container-lowest rounded-[24px] p-8 shadow-sm border border-outline-variant/20 flex flex-col h-full transition-transform duration-300 hover:-translate-y-1\">\n                        <h3 className=\"font-headline-md text-headline-md text-primary mb-6\">Asset Library</h3>\n                        <div className=\"grid grid-cols-2 gap-3 flex-1\">\n                            <div className=\"aspect-square rounded-2xl overflow-hidden relative group\">\n                                <img alt=\"Asset 1\" className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuB8u0BZVG7y6w2DYWSqfNmkDDIWXshXBI3BNF8OdaEIDsCte0qmHqF3u-tcQw9LjARw_FBjHGjJj8nuT5W0swJQE4atpqkzp3cAh5vVD9LopahMbrSgU0cquYGgS4B8d-vGYp3rviyZ3nkBeh0QDoQmFbO0m7tzEsMWiYV6-ohAOSe5EwZDiGey16nTcEg7IaJwkLVXR0uMfBrwf2x-y5XUOQYMrPdxHWSOe0HBAQ4kGGJvV8sWnaf-0TbRQz0vGMmGEjqSHBsbO2Q\"/>\n                            </div>\n                            <div className=\"aspect-square rounded-2xl overflow-hidden relative group\">\n                                