    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ScreenType } from \'../App\';\n\nexport default function GalleryScreen({ onNavigate }: { onNavigate: (screen: ScreenType) => void }) {\n    return (\n        <div className=\"bg-background text-on-background min-h-screen font-body-md overflow-x-hidden grain-bg\">\n            <header className=\"fixed top-0 w-full z-50 bg-surface/90 dark:bg-surface-container-high/90 backdrop-blur-md shadow-sm\">\n                <div className=\"flex justify-between items-center px-margin-mobile md:px-margin-desktop h-20 max-w-container-max mx-auto\">\n                    <div onClick={() => onNavigate(\'landing\')} className=\"font-display-lg text-headline-md font-extrabold text-leaf-green dark:text-secondary-fixed tracking-tight cursor-pointer\">\n                        dziubki_explore\n                    </div>\n                    <nav className=\"hidden md:flex items-center gap-8\">\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer font-label-sm text-label-sm text-on-surface-variant hover:text-leaf-green transition-colors\">MAPA</a>\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'gallery\'); }} className=\"cursor-pointer font-label-sm text-label-sm text-leaf-green font-bold border-b-2 border-coral-sunrise pb-1\">GALERIA</a>\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'live\'); }} className=\"cursor-pointer font-label-sm text-label-sm text-on-surface-variant hover:text-leaf-green transition-colors\">LIVE STREAM</a>\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'profiles\'); }} className=\"cursor-pointer font-label-sm text-label-sm text-on-surface-variant hover:text-leaf-green transition-colors\">PROFIL</a>\n                    </nav>\n                    <div className=\"flex items-center gap-4\">\n                        <button className=\"p-2 hover:bg-surface-container-lowest/50 rounded-full transition-all duration-200\">\n                            <span className=\"material-symbols-outlined text-leaf-green\">notifications</span>\n                        </button>\n                        <button onClick={() => onNavigate(\'dashboard\')} className=\"p-2 hover:bg-surface-container-lowest/50 rounded-full transition-all duration-200\">\n                            <span className=\"material-symbols-outlined text-leaf-green\">settings</span>\n                        </button>\n                        <div className=\"w-10 h-10 rounded-full border-2 border-leaf-green overflow-hidden\">\n                            <img alt=\"Mateusz and Magda\" className=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAP9Q4JvTvWKjmXvEjgq6KWtKkl2B1tXGiVlDwZe7JQkSmfv_Xx4vJudkKkxLyq28113ZG6P_uIvHCd9ev_263mMgAyj5YF_sPnLyjlR0vuIIFZnNfEmHGDUATPHvlho_MLzE7-69JevUSiexHvmptBPq_IuaaqagLMsHeZxh0OAEjOJHe8sbfey0iJ-0Ox29vxO6BxoQhsYRKrVbD0HhNIFKQoHhuSksyNQUO8rD0ZEmRnl6dzSfKF0vKWVgD85xJcH4Qccuqv-Wk\"/>\n                        </div>\n                    </div>\n                </div>\n            </header>\n\n            <main className=\"pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto\">\n                <section className=\"mb-section-gap\">\n                    <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6\">\n                        <div>\n                            <span className=\"font-label-sm text-label-sm text-leaf-green tracking-[0.2em] uppercase mb-4 block\">Expedition Logs</span>\n                            <h1 className=\"font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary max-w-2xl\">\n                                Unfiltered stories from the heart of the <span className=\"text-coral-sunrise\">unseen wilderness</span>.\n                            </h1>\n                        </div>\n                        <div className=\"bg-surface-container-low p-2 rounded-full flex items-center gap-2 border border-outline-variant/20\">\n                            <button className=\"px-6 py-2 rounded-full font-label-sm text-label-sm bg-leaf-green text-on-secondary transition-all\">\n                                PUBLIC ARCHIVE\n                            </button>\n                            <button className=\"px-6 py-2 rounded-full font-label-sm text-label-sm text-on-surface-variant hover:bg-surface-container-high transition-all flex items-center gap-2\">\n                                <span className=\"material-symbols-outlined text-[18px]\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>volunteer_activism</span>\n                                PATRON ACCESS\n                            </button>\n                        </div>\n                    </div>\n                </section>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-12 gap-gutter\">\n                    {/* Featured Card */}\n                    <div className=\"md:col-span-8 group cursor-pointer relative overflow-hidden rounded-3xl bg-surface-container shadow-xl transition-all duration-500 hover:-translate-y-2\">\n                        <div className=\"aspect-[16/10] overflow-hidden\">\n                            <img alt=\"Hidden Waterfalls\" className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuANfaGy2j_7q4iTTwQCfxnUE-EUK3qdVwpT8nRPKG7gaQgdD31yO6iOh0-cIUmq_PVsdZ_XyGeBcChrSPYt3NfGZN4_j_dWvUbuhzLoxg3OgRl275WPSvCqm75i-xc5Ex8MA-cXRHfNm5BoCThMzOjAkalLXzP1CU4x07u_Pz1ODpkt719qmr8LCcuRndmHKngOc9NxvqzukIWNvfWYea2wlqQt1vgLPDJD0_nbZRnky--kmiLbFX6c6JvxVDdfbeDhIc78n0bxYhM\"/>\n                            <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent\"></div>\n                        </div>\n                        <div className=\"absolute top-6 left-6 flex gap-2\">\n                            <span className=\"bg-coral-sunrise/90 backdrop-blur-md text-white px-3 py-1 rounded-full font-label-sm text-label-sm shadow-[0_0_15px_rgba(255,127,80,0.5)]\">FEATURED</span>\n                        </div>\n                        <div className=\"absolute bottom-0 left-0 right-0 p-8\">\n                            <div className=\"flex items-center gap-2 mb-2 text-secondary-fixed font-label-sm text-label-sm\">\n                                <span className=\"material-symbols-outlined text-[16px]\">location_on</span>\n                                MONTEVERDE CLOUD FOREST <span className=\"mx-2\">\342\200\242</span> NOV 2023\n                            </div>\n                            <h3 className=\"font-headline-md text-headline-md text-white\">The Emerald Veil: Tracking Rare Quetzals</h3>\n                            <p className=\"text-white/70 font-body-md mt-2 max-w-md line-clamp-2\">A 14-day trek through dense canopy layers and misty ridges to document the migration of the resplendent quetzal.</p>\n                        </div>\n                    </div>\n\n                    {/* Side Cards */}\n                    <div className=\"md:col-span-4 group cursor-pointer relative overflow-hidden rounded-3xl bg-surface-container-high shadow-lg transition-all duration-500 hover:-translate-y-2\">\n                        <div className=\"aspect-[4/5] overflow-hidden\">\n                            <img alt=\"Coastal Explorer\" className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuD9kdE4SScSld6FIp4u87GAHPHiVIcjXhhl5laDe3a4YPY9-bddUEY-tkZFoW0nh8FhSvm5M08lu2SHn_bTGibyudbGi16habodYh3K1q5LrZXIAuOyTLN8-CxEbkqztNQjsztTsGjOJveVByh086EQaIKsVwFlMlkGxi-yYPusT2fXa72Sn0T0BFx4cFWf1UJm81FYt2gPEi8bGLZ415ZTS0CZ7shRcHUJEpJ1R99WCHu2v9lNBC26qSgeXubfqEiysxaEC-Xw4Oc\"/>\n                            <div className=\"absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent\"></div>\n                        </div>\n                        <div className=\"absolute top-6 right-6\">\n                            <div className=\"bg-jungle-deep/80 backdrop-blur-md p-2 rounded-full text-secondary-fixed\">\n                                <span className=\"material-symbols-outlined\">lock</span>\n                            </div>\n                        </div>\n                        <div className=\"absolute bottom-0 left-0 right-0 p-6\">\n                            <div className=\"text-secondary-fixed-dim font-label-sm text-label-sm mb-1 uppercase tracking-wider\">Bali, Indonesia \342\200\242 Oct 2023</div>\n                            <h3 className=\"font-headline-md text-headline-md text-white text-[20px] leading-tight\">Salt & Spirit: Secret Surfs of Uluwatu</h3>\n                        </div>\n                    </div>\n\n                    <div className=\"md:col-span-4 group cursor-pointer relative overflow-hidden rounded-3xl bg-surface-container shadow-lg transition-all duration-500 hover:-translate-y-2\">\n                        <div className=\"aspect-square overflow-hidden\">\n                            <img alt=\"Tropical Flora\" className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuD0oRZ_eKo3z7REoTRe2mbuGE3fD7JI2G3qQDVBLBLBhab3WXOLRrKQIV5oLYhppaeZ58fgaLHdC2eKPB_qLrLB7JKrKXOEvTWvzhc_e5uw4mjGEEYReVStCwFhHbmTQ4pOLieygtH2nyNDR2EZwVpUSbAbmR-jXKAHWnN0MaMqi1q8aHKhXg8huZ3QroRQXx5a4hifyRp0KiNCfnygl8yP3mjcUZfpvFv4dHRQ2Efo-pcTYmiSoh2Kj6XZfb9hJQWdvTqEOsAiesc\"/>\n                            <div className=\"absolute inset-0 bg-gradient-to-t from-jungle-deep/80 via-transparent to-transparent\"></div>\n                        </div>\n                        <div className=\"absolute bottom-0 left-0 right-0 p-6\">\n                            <div className=\"text-secondary-fixed font-label-sm text-label-sm mb-1 uppercase tracking-wider\">Amazonas \342\200\242 Sept 2023</div>\n                            <h3 className=\"font-headline-md text-headline-md text-white text-[20px] leading-tight\">Macaw Valley: Primary Jungle Colors</h3>\n                        </div>\n                    </div>\n\n                    {/* Patreon CTA */}\n                    <div className=\"md:col-span-8 bg-jungle-deep text-secondary-fixed p-10 rounded-3xl relative flex flex-col justify-between overflow-hidden group\">\n                        <div className=\"absolute -right-10 -bottom-10 opacity-10 group-hover:opacity-20 transition-opacity duration-700\">\n                            <span className=\"material-symbols-outlined text-[300px]\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>volunteer_activism</span>\n                        </div>\n                        <div className=\"relative z-10\">\n                            <span className=\"font-label-sm text-label-sm bg-leaf-green px-4 py-1 rounded-full text-white inline-block mb-6\">SUPPORT THE JOURNEY</span>\n                            <h2 className=\"font-headline-lg text-headline-lg leading-none mb-4\">Unlock 200+ Hidden <br/>Photo Expeditions.</h2>\n                            <p className=\"font-body-lg text-body-lg text-secondary-fixed/80 max-w-lg\">\n                                Patrons get early access to high-res raw photo dumps, GPS coordinates of shoot locations, and behind-the-scenes gear talk.\n                            </p>\n                        </div>\n                        <div className=\"relative z-10 mt-12 flex flex-wrap gap-8 items-center\">\n                            <button className=\"bg-coral-sunrise text-primary font-bold px-10 py-4 rounded-full uppercase tracking-widest hover:scale-105 active:scale-95 transition-all shadow-[0_0_25px_rgba(255,127,80,0.4)]\">\n                                JOIN THE PATREON\n                            </button>\n                            <div className=\"flex -space-x-3\">\n                                <img alt=\"User\" className=\"w-12 h-12 rounded-full border-4 border-jungle-deep\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAEL37n4YZRZ_c6ZAZ-HHmfpY6l4W-GuWPbFZBvhN9qVz5KkLWnXbw2Pint4piGHeUYznswxzS8slQGfd2Z2sBwlcB5TKgKlU0rKYu-wl1Fyf4KyyEUAT4wx4L-nYONZ7FFq8eU_oOX0mykxyUPfnzSkH0QKhAa1vibQ_oS-CmD2keSuvPHgigzxk53oTPXCimKCA2PiIY1A2txU7a3XYrHbqHRObouS4FVjzi4ietDGWUQx7PZOSRSAOcDR2nEK6jYjde8WfZ-IzY\"/>\n                                <img alt=\"User\" className=\"w-12 h-12 rounded-full border-4 border-jungle-deep\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBrloP0tBiAEX9Xk8Jl8xAorT0r883IxoW50ui10X-IgcmeInLH2sLIakus5oKOhwMuvvyHkZkCdFVtuKb3QfJjmhoY-ezrb7Gc2Apf0VEcds13C3tvINHyeT5y_ho5UJR7opbhljCih4RpFRxJKQT1lW-UIuRXZzeidVea20I90AJcMm1M_2s3jbuqsTF6-wglZ9XLLgmsqxonGIT-UJQ199pMRAbUywPNjj8-BvViq5Rgt2MvQZaxRiaz2WOGZHOJUfi2c94H0Js\"/>\n                                <img alt=\"User\" className=\"w-12 h-12 rounded-full border-4 border-jungle-deep\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuD2jSr0ShhSEOwMui8ThwHuAHcSngkhYiRKQYLTFO9qp73XqcW4s4q73JPeuxiVkRmXPC0R4ezEjDKfNngvwxsZeySajRRqPeIdblgI0pk5K995UrkKfFap5owhi3GwkCwezorfPgFB_tGmU4-wjkWwZS-CuINqdg46LwWRtucQ2y-u3ztBuLcgGmaKKenKVxiMHZWwsQpGnVse8lvlAciTxx1h01QP8i99n4irtYpo4ngRbi6Q1DtJbovxg3jnT1hhJs967DN394E\"/>\n                                <div className=\"w-12 h-12 rounded-full bg-leaf-green border-4 border-jungle-deep flex items-center justify-center font-label-sm text-label-sm\">+2.4k</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                {/* Secondary Grid */}\n                <div className=\"mt-gutter grid grid-cols-1 md:grid-cols-3 gap-gutter\">\n                    <div className=\"group cursor-pointer\">\n                        <div className=\"aspect-[3/