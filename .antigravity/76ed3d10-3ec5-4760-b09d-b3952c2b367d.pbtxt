        replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --color-outline: #717973;\n  --color-tertiary-fixed: #ffdbcf;\n  --color-sand-surface: #f8f9fa;\n  --color-surface-container-high: #e7e8e9;\n  --color-surface-tint: #3e6653;\n  --color-surface: #f8f9fa;\n  --color-surface-container-low: #f3f4f5;\n  --color-secondary-fixed-dim: #95d4b3;\n  --color-inverse-surface: #2e3132;\n  --color-error: #ba1a1a;\n  --color-primary-fixed-dim: #a5d0b8;\n  --color-on-secondary-fixed: #002114;\n  --color-coral-sunrise: #ff7f50;\n  --color-error-container: #ffdad6;\n  --color-surface-container-lowest: #ffffff;\n  --color-primary-container: #012d1d;\n  --color-outline-variant: #c1c8c2;\n  --color-primary-fixed: #c0edd4;\n  --color-on-secondary-container: #316e52;\n  --color-on-primary-fixed-variant: #264e3c;\n  --color-tertiary: #280700;\n  --color-surface-container-highest: #e1e3e4;\n  --color-on-background: #191c1d;\n  --color-background: #f8f9fa;\n  --color-on-tertiary-container: #e26a3c;\n  --color-on-secondary: #ffffff;\n  --color-primary: #00160c;\n  --color-on-primary: #ffffff;\n  --color-error-alert: #ba1a1a;\n  --color-on-secondary-fixed-variant: #0e5138;\n  --color-surface-container: #edeeef;\n  --color-jungle-deep: #012d1d;\n  --color-leaf-green: #2c694e;\n  --color-on-surface-variant: #414844;\n  --color-on-error-container: #93000a;\n  --color-surface-bright: #f8f9fa;\n  --color-on-error: #ffffff;\n  --color-inverse-primary: #a5d0b8;\n  --color-secondary: #2c694e;\n  --color-tertiary-fixed-dim: #ffb59c;\n  --color-on-tertiary: #ffffff;\n  --color-on-surface: #191c1d;\n  --color-on-primary-fixed: #002114;\n  --color-secondary-fixed: #b1f0ce;\n  --color-on-primary-container: #6d9681;\n  --color-surface-variant: #e1e3e4;\n  --color-tertiary-container: #4b1300;\n  --color-on-tertiary-fixed: #380c00;\n  --color-on-tertiary-fixed-variant: #822800;\n  --color-surface-dim: #d9dadb;\n  --color-secondary-container: #aeeecb;\n  --color-inverse-on-surface: #f0f1f2;\n\n  --font-headline-lg-mobile: \"Epilogue\", ui-sans-serif, system-ui, sans-serif;\n  --font-headline-lg: \"Epilogue\", ui-sans-serif, system-ui, sans-serif;\n  --font-label-sm: \"Be Vietnam Pro\", ui-sans-serif, system-ui, sans-serif;\n  --font-quote-italic: \"Epilogue\", ui-sans-serif, system-ui, sans-serif;\n  --font-display-lg: \"Epilogue\", ui-sans-serif, system-ui, sans-serif;\n  --font-headline-md: \"Epilogue\", ui-sans-serif, system-ui, sans-serif;\n  --font-body-md: \"Be Vietnam Pro\", ui-sans-serif, system-ui, sans-serif;\n  --font-body-lg: \"Be Vietnam Pro\", ui-sans-serif, system-ui, sans-serif;\n\n  --spacing-margin-desktop: 64px;\n  --spacing-container-max: 1280px;\n  --spacing-section-gap: 80px;\n  --spacing-unit: 4px;\n  --spacing-gutter: 24px;\n  --spacing-margin-mobile: 20px;\n}\n\n@layer base {\n  html {\n    font-family: var(--font-body-md);\n    scroll-behavior: smooth;\n  }\n}\n\n@layer components {\n  .material-symbols-outlined {\n    font-variation-settings: \'FILL\' 0, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n  }\n}\n\n@layer utilities {\n  .grain-bg {\n    background-image: url(\"https://www.transparenttextures.com/patterns/natural-paper.png\");\n  }\n  .grain-overlay {\n    background-image: url(\"https://www.transparenttextures.com/patterns/carbon-fibre.png\");\n    opacity: 0.03;\n    pointer-events: none;\n  }\n  .coral-glow {\n    box-shadow: 0 10px 30px -10px rgba(255, 127, 80, 0.6);\n  }\n  .coral-glow-strong {\n    box-shadow: 0 0 25px rgba(255, 127, 80, 0.5);\n  }\n  @keyframes pulse-red {\n    0% { box-shadow: 0 0 0 0 rgba(186, 26, 26, 0.7); }\n    70% { box-shadow: 0 0 0 15px rgba(186, 26, 26, 0); }\n    100% { box-shadow: 0 0 0 0 rgba(186, 26, 26, 0); }\n  }\n  .pulse-live {\n    animation: pulse-red 2s infinite;\n  }\n  .tropical-bg {\n    background: linear-gradient(135deg, rgba(248, 249, 250, 0.95) 0%, rgba(193, 236, 212, 0.15) 50%, rgba(248, 249, 250, 0.95) 100%);\n    background-attachment: fixed;\n  }\n  .hero-glass {\n    background: rgba(0, 0, 0, 0.2);\n    backdrop-filter: blur(8px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n  .glass-panel {\n    background: rgba(255, 255, 255, 0.7);\n    backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.5);\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.05);\n  }\n  .map-3d-effect {\n    transform: perspective(1000px) rotateX(15deg);\n    box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.4), 0 30px 60px -30px rgba(0, 0, 0, 0.5);\n  }\n  @keyframes map-pulse {\n    0% { transform: scale(0.5); opacity: 1; }\n    100% { transform: scale(2.5); opacity: 0; }\n  }\n  .map-ring {\n    animation: map-pulse 2s cubic-bezier(0.455, 0.03, 0.515, 0.955) infinite;\n  }\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-10px); }\n  }\n  .animate-float {\n    animation: float 4s ease-in-out infinite;\n  }\n}"
