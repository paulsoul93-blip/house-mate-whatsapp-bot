  file_change {
    absolute_path_uri: "file:///src/screens/LiveStreamScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { ScreenType } from \'../App\';\n\nexport default function LiveStreamScreen({ onNavigate }: { onNavigate: (screen: ScreenType) => void }) {\n    const [messages, setMessages] = useState([\n        { user: \'Marek_K\', msg: \'Ten las wygl\304\205da nierealnie! \360\237\214\277\342\234\250 Czy to te same ro\305\233liny co na Bali?\', init: \'MK\', clr:\'text-coral-sunrise\' },\n        { user: \'Anna_D\', msg: \'Czekam na ten moment przy ognisku!\', init: \'AD\', clr:\'text-leaf-green\' },\n        { user: \'Moderator_Jan\', msg: \'Pami\304\231tajcie o kulturze! Zapraszamy do wspierania dziubk\303\263w! \342\230\225\357\270\217\', init: \'MOD\', clr:\'text-white\', bg:\'bg-coral-sunrise\' }\n    ]);\n    const chatEndRef = useRef<HTMLDivElement>(null);\n\n    useEffect(() => {\n        const simulatedUsers = [\'Kamil_Travel\', \'Globetrotter99\', \'NatureLover\', \'MartaW\'];\n        const simulatedMessages = [\n            \'Mega jako\305\233\304\207 obrazu dzisiaj! \360\237\224\245\',\n            \'Pozdrowienia z Warszawy!\',\n            \'Ile tam jest stopni teraz?\',\n            \'Uwa\305\274ajcie na paj\304\205ki \360\237\225\267\357\270\217\360\237\230\202\',\n            \'Ta bioluminescencja jest niesamowita\'\n        ];\n        const timer = setInterval(() => {\n            const user = simulatedUsers[Math.floor(Math.random() * simulatedUsers.length)];\n            const msg = simulatedMessages[Math.floor(Math.random() * simulatedMessages.length)];\n            const init = user.substring(0,2).toUpperCase();\n            setMessages(prev => [...prev.slice(-15), { user, msg, init, clr:\'text-leaf-green\' }]);\n        }, 4000);\n        return () => clearInterval(timer);\n    }, []);\n\n    useEffect(() => {\n        chatEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n    }, [messages]);\n\n    return (\n        <div className=\"bg-jungle-deep text-on-surface-variant font-body-md dark overflow-x-hidden min-h-screen\">\n            <div className=\"fixed inset-0 grain-overlay z-[100]\"></div>\n            \n            {/* TopNavBar */}\n            <header className=\"fixed top-0 w-full z-50 bg-surface/90 dark:bg-surface-container-high/90 backdrop-blur-md shadow-sm\">\n                <nav className=\"flex justify-between items-center px-margin-mobile md:px-margin-desktop h-20 max-w-container-max mx-auto relative z-10\">\n                    <div className=\"flex items-center gap-8\">\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer font-display-lg text-headline-md font-extrabold text-leaf-green dark:text-secondary-fixed tracking-tight\">dziubki_explore</a>\n                        <div className=\"hidden md:flex gap-6\">\n                            <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer font-label-sm text-on-surface-variant hover:text-leaf-green transition-colors\">MAPA</a>\n                            <a onClick={(e) => { e.preventDefault(); onNavigate(\'gallery\'); }} className=\"cursor-pointer font-label-sm text-on-surface-variant hover:text-leaf-green transition-colors\">GALERIA</a>\n                            <a onClick={(e) => { e.preventDefault(); onNavigate(\'live\'); }} className=\"cursor-pointer font-label-sm text-leaf-green font-bold border-b-2 border-coral-sunrise pb-1\">LIVE STREAM</a>\n                        </div>\n                    </div>\n                    <div className=\"flex items-center gap-4\">\n                        <div className=\"relative hidden sm:block\">\n                            <span className=\"material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline\">search</span>\n                            <input className=\"bg-surface-container-low border-none rounded-full py-2 pl-10 pr-4 text-body-md focus:ring-2 focus:ring-secondary-fixed w-64\" placeholder=\"Search streams...\" type=\"text\"/>\n                        </div>\n                        <button className=\"material-symbols-outlined text-leaf-green dark:text-secondary-fixed hover:bg-surface-container-lowest/50 p-2 rounded-full transition-all\">notifications</button>\n                        <button onClick={() => onNavigate(\'dashboard\')} className=\"material-symbols-outlined text-leaf-green dark:text-secondary-fixed hover:bg-surface-container-lowest/50 p-2 rounded-full transition-all cursor-pointer\">settings</button>\n                        <img alt=\"User profile\" className=\"w-10 h-10 rounded-full object-cover border-2 border-coral-sunrise cursor-pointer\" onClick={() => onNavigate(\'profiles\')} src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAsziW_URTaNQZqWNIRDqkP0wVxdfWzuz7CjY0dBgQjreoZrDDuHwjS6XdMeyhXO2Ud13bbF6MDiwK-q8H709C0Fee1683VfHevNc8GSA6VLqvySJG_qu1dLDQ0EH2M6hZ_tAFBOzidypi8ZhA4IJTPHvPzwUdX80wT9nK1HZCyXY4Xqa1sdJz7OjAY901THCu0Dk0IwHeuMTIcA64WGcqAOCZM8B3RF1tldv2bB6v9v7z60i8jclhlF1Ipuv990zRN5KAiplzRpY0\"/>\n                    </div>\n                </nav>\n            </header>\n\n            <main className=\"pt-24 pb-32 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto relative z-10\">\n                <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-gutter\">\n                    {/* Video Section */}\n                    <div className=\"lg:col-span-8 flex flex-col gap-6\">\n                        <div className=\"relative aspect-video rounded-3xl overflow-hidden shadow-2xl group border border-outline-variant/10\">\n                            <img alt=\"Live Stream\" className=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLtCZ8Pq-WO83KHGXGJyAVOlJUJtgXYg5y8YAHhIdJyQSTJV8MG5e1F_ItvJ-o-_rfoPLUwM1FpX2nLzc3yKUgJWJAtmN-xOaxsWscpm6G7yyq0iZ9ezB2TAWJFQBYWrND-BMWg5C8BoAUTZz73nwhJnhclP5jw7lKIu05dmmBR9ZYDujEwEmC34Z6k8uNB_5IFHW8QjF-zpO_de35HCp8EueQu03fLMdgAvvng7gWkV904brpLyE0e-MQQ\"/>\n                            <div className=\"absolute top-6 left-6 flex items-center gap-3\">\n                                <div className=\"bg-error flex items-center gap-2 px-3 py-1 rounded-full text-on-error font-bold text-label-sm coral-glow\">\n                                    <span className=\"w-2 h-2 bg-white rounded-full animate-pulse\"></span> LIVE\n                                </div>\n                                <div className=\"bg-black/40 backdrop-blur-md px-3 py-1 rounded-full text-white font-bold text-label-sm flex items-center gap-2\">\n                                    <span className=\"material-symbols-outlined text-[16px]\">visibility</span> 1.2k\n                                </div>\n                            </div>\n                            <div className=\"absolute bottom-6 left-6 right-6 flex items-center justify-between\">\n                                <div className=\"flex items-center gap-4\">\n                                    <button className=\"w-12 h-12 rounded-full bg-white/20 backdrop-blur-lg flex items-center justify-center text-white hover:bg-white/30 transition-all\">\n                                        <span className=\"material-symbols-outlined\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>play_arrow</span>\n                                    </button>\n                                    <div className=\"text-white\">\n                                        <h1 className=\"font-headline-md text-white drop-shadow-md\">Nocny Trekking przez Bioluminescencyjn\304\205 D\305\274ungl\304\231</h1>\n                                        <p className=\"text-white/80 text-body-md\">dziubki_explore \342\200\242 Ostatnia granica</p>\n                                    </div>\n                                </div>\n                                <div className=\"flex gap-2\">\n                                    <button className=\"w-10 h-10 rounded-full bg-white/20 backdrop-blur-lg flex items-center justify-center text-white hover:bg-coral-sunrise transition-all\">\n                                        <span className=\"material-symbols-outlined\">share</span>\n                                    </button>\n                                    <button className=\"w-10 h-10 rounded-full bg-white/20 backdrop-blur-lg flex items-center justify-center text-white hover:bg-coral-sunrise transition-all\">\n                                        <span className=\"material-symbols-outlined\">fullscreen</span>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n\n                        {/* Action Bar */}\n                        <div className=\"flex items-center justify-between bg-surface-container-lowest/5 backdrop-blur-sm p-4 rounded-3xl border border-outline-variant/10\">\n                            <div className=\"flex items-center gap-4\">\n                                <div className=\"flex -space-x-3\">\n                                    <img alt=\"User\" className=\"w-10 h-10 rounded-full border-2 border-jungle-deep\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDaCUz-XtRrMiicbNL3GE0-I1Gb3wTa-jEut0YEBT-iE4g1_f2HTO05A2Z8zbfEyH8buYJ86wNssmr4HIUMIlZfJH6AHC3YdHzooZ-TV7uTNoKglwhSIBVCDsrCagZv5rJLdJ113ER9tPlD6xyhm3J4duWx5gMTI9Vj085kVuaU79Z5Q-mperSsPcMUw2jsqoAfD6_uGxTG-vDour5m4FjFF78u8UI-svlrXq2nPLHYS9fC2LBbhvAarXPuXX8tTzD8HVQpQM53lps\"/>\n                                    <img alt=\"User\" className=\"w-10 h-10 rounded-full border-2 border-jungle-deep\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuD8ximkeuE5l1a0vOrD3gH6j4-K5yHgi7gXVL-lGmVITJH8lBSG6tzVjkZtvNQIYv1YbjMJWzu4KEurLqk2p9FDtMMKoo-0ydEC5isGh8HPUsLBTXtxnPLtXqrK5WP5LZ62edNceuDORSUmuxWtsl9Dj4AutvEn6LZc_FfLaDAkxB81U7K46Q8WwH5fUGNSZyO5p_BcjNKs6pyHg-DZvh9hJ17XA7uqyk_DWN22d3G4XpCBcf_Y5KDAos9sHNS9gULV4fUe4dg0vgk\"/>\n                                    <div className=\"w-10 h-10 rounded-full bg-leaf-green flex items-center justify-center text-white text-[12px] font-bold border-2 border-jungle-deep\">+45</div>\n                                </div>\n                                <p className=\"text-on-secondary-fixed text-body-md\"><span className=\"font-bold text-coral-sunrise\">Magda & Tomek</span> just joined the adventure!</p>\n                            </div>\n                            <button className=\"px-6 py-2 rounded-full bg-coral-sunrise text-white font-bold coral-glow-strong hover:scale-105 transition-transform flex items-center gap-2\">\n                                <span className=\"material-symbols-outlined text-[20px]\">volunteer_activism</span>\n                                SUPPORT THE TRIP\n                            </button>\n                        </div>\n                    </div>\n\n                    {/* Chat Panel */}\n                    <div className=\"lg:col-span-4 h-[calc(100vh-12rem)] min-h-[500px] flex flex-col bg-surface-container-lowest/5 backdrop-blur-lg rounded-3xl border border-outline-variant/10 overflow-hidden shadow-xl\">\n                        <div className=\"p-5 border-b border-outline-variant/10 flex items-center justify-between\">\n                            <h2 className=\"font-headline-md text-[20px] text-secondary-fixed flex items-center gap-2\">\n                                <span className=\"material-symbols-outlined text-coral-sunrise\">forum</span> Live Chat\n                            </h2>\n                            <span className=\"text-label-sm text-outline\">1,248 Explorers</span>\n                        </div>\n                        <div className=\"flex-1 overflow-y-auto p-5 space-y-4\">\n                            {messages.map((m, i) => (\n                                <div key={i} className=\"flex gap-3 items-start animate-fade-in\">\n                                    <div className={`w-8 h-8 rounded-full ${m.bg ? m.bg : \'bg-surface-container-lowest/10\'} flex-shrink-0 flex items-center justify-center ${m.clr} font-bold text-[10px]`}>{m.init}</div>\n                                    <div className=\"bg-surface-container-high/10 p-3 rounded-2xl rounded-tl-none\">\n                                        <p className={`text-label-sm font-bold ${m.clr} mb-1`}>{m.user}</p>\n                                        <p className=\"text-body-md text-on-secondary-fixed-variant\">{m.msg}</p>\n                                    </div>\n                                </div>\n                            ))}\n                            <div ref={chatEndRef}></div>\n                        </div>\n                        <div className=\"p-5 bg-black/20\">\n                            <div className=\"relative\">\n                                <input className=\"w-full bg-surface-container-lowest/10 border border-outline-variant/20 rounded-2xl py-3 px-4 text-white focus:outline-none focus:ring-2 focus:ring-coral-sunrise\" placeholder=\"Send a message...\" type=\"text\"/>\n                                <button className=\"absolute right-2 top-1/2 -translate-y-1/2 p-2 text-coral-sunrise\"><span className=\"material-symbols-outlined\">send</span></button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"mt-section-gap grid grid-cols-1 md:grid-cols-2 gap-gutter\">\n                    <section>\n                        <div className=\"flex items-center justify-between mb-8\">\n                            <h3 className=\"font-headline-md text-secondary-fixed flex items-center gap-3\">\n                                <span className=\"material-symbols-outlined text-coral-sunrise\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>calendar_month</span> Upcoming Streams\n                            </h3>\n                        </div>\n                        <div className=\"space-y-4\">\n                            <div className=\"flex items-center gap-4 bg-surface-container-lowest/5 p-4 rounded-3xl border border-outline-variant/10 group hover:bg-surface-container-lowest/10 transition-all\">\n                                <div className=\"w-20 h-20 rounded-2xl overflow-hidden flex-shrink-0\">\n                                    <img alt=\"Upcoming\" className=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBcZ68Sb1YNGTfpvxVXl2H9Oemi_og5swW75RaZYpR45LAgyD4GrR9OlyBt7s00MNi7GQVnm9wbXnuYg3-Wk47-gDpA39mIaM7IP_e1CvaHCho9PkQ09ulChIxRUH9aaMxSmq1QDXRgM4k6t7Kk4V_gsoyAz8x3Br3FN96E5LllaelbbISGJRbwAiGYhb5waua7ASupjkp0u5GWcfr9jul9j_sCf4-PDyz5YF0MlJ6jNmtxhoTJScBigbJilgIhFkFRKsm7XXqTMGE\"/>\n                                </div>\n                                <div className=\"flex-1\">\n                                    <p className=\"text-coral-sunrise font-bold text-label-sm\">TOMORROW, 18:00</p>\n                                    <h4 className=\"text-secondary-fixed font-bold text-body-lg\">Wodospady Ukryte w Chmurach</h4>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n            </main>\n\n            <nav className=\"fixed bottom-0 left-0 w-full flex justify-around items-center h-16 px-4 md:hidden bg-surface/95 dark:bg-surface-container-highest/95 backdrop-blur-lg z-50 rounded-t-xl shadow-[0_-4px_10px_rgba(0,0,0,0.05)] border-t border-outline-variant/20\">\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform\">\n                    <span className=\"material-symbols-outlined\">explore</span>\n                    <span className=\"font-label-sm text-label-sm\">Mapa</span>\n                </a>\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'gallery\'); }} className=\"cursor-pointer flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform\">\n                    <span className=\"material-symbols-outlined\">photo_library</span>\n                    <span className=\"font-label-sm text-label-sm\">Galeria</span>\n                </a>\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'live\'); }} className=\"cursor-pointer flex flex-col items-center justify-center bg-secondary-container text-on-secondary-container rounded-full px-5 py-1 shadow-[0_0_15px_rgba(255,127,80,0.3)] scale-110\">\n                    <span className=\"material-symbols-outlined\">sensors</span>\n                    <span className=\"font-label-sm text-label-sm\">Live</span>\n                </a>\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'profiles\'); }} className=\"cursor-pointer flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform\">\n                    <span className=\"material-symbols-outlined\">person</span>\n                    <span className=\"font-label-sm text-label-sm\">Profil</span>\n                </a>\n            </nav>\n        </div>\n    );\n}"
    }
