    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ScreenType } from \'../App\';\n\nexport default function ProfileScreen({ onNavigate }: { onNavigate: (screen: ScreenType) => void }) {\n    return (\n        <div className=\"bg-background text-on-background grain-bg font-body-md min-h-screen\">\n            {/* TopNavBar */}\n            <nav className=\"fixed top-0 w-full z-50 bg-surface/90 dark:bg-surface-container-high/90 backdrop-blur-md shadow-sm\">\n                <div className=\"flex justify-between items-center px-margin-mobile md:px-margin-desktop h-20 max-w-container-max mx-auto\">\n                    <div onClick={() => onNavigate(\'landing\')} className=\"cursor-pointer font-display-lg text-headline-md font-extrabold text-leaf-green dark:text-secondary-fixed tracking-tight\">\n                        dziubki_explore\n                    </div>\n                    <div className=\"hidden md:flex gap-8 items-center\">\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer text-leaf-green font-bold border-b-2 border-coral-sunrise pb-1 font-label-sm\">Mapa</a>\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'gallery\'); }} className=\"cursor-pointer text-on-surface-variant hover:text-leaf-green transition-colors font-label-sm\">Galeria</a>\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'live\'); }} className=\"cursor-pointer text-on-surface-variant hover:text-leaf-green transition-colors font-label-sm\">Live Stream</a>\n                        <div className=\"flex items-center gap-4 ml-4\">\n                            <span className=\"material-symbols-outlined text-on-surface-variant cursor-pointer hover:bg-surface-container-lowest/50 p-2 rounded-full transition-all\">notifications</span>\n                            <span onClick={() => onNavigate(\'dashboard\')} className=\"material-symbols-outlined text-on-surface-variant cursor-pointer hover:bg-surface-container-lowest/50 p-2 rounded-full transition-all\">settings</span>\n                            <img alt=\"Mateusz and Magda\" className=\"w-10 h-10 rounded-full border-2 border-leaf-green object-cover shadow-sm\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAK_dCTBE4ONXrhUjXu1TzYQiENC0SQ-JwdzRrvsOGJIlQbFUOIZsbEy2022waRPkxoxl89cyE6K1pH_Cl5TjJpRXLMJB622ahBQmUgMDMcwV7O74nBTCSTlt130JE-It3hySnd-O101AwYHDCQRDOOOq31K3_XyqQ8jqQWQ2ho23wRX9LWU0vvhFTZpogg0L7LgaAXK3XEtBNJgrChRj6xpuHVt-a26fnQD9-MFsl4Z_ZikvplBV_xM_z3fQS25Etuz2GbNzw3urg\"/>\n                        </div>\n                    </div>\n                    <div className=\"md:hidden\">\n                        <span className=\"material-symbols-outlined text-leaf-green text-3xl\">menu</span>\n                    </div>\n                </div>\n            </nav>\n\n            <main className=\"pt-24 pb-32 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop\">\n                {/* Hero Header */}\n                <header className=\"mb-section-gap text-center md:text-left\">\n                    <span className=\"bg-secondary-container text-on-secondary-container px-4 py-1 rounded-full font-label-sm inline-block mb-4\">NASZE DZIKIE \305\273YCIE</span>\n                    <h1 className=\"font-display-lg text-headline-lg-mobile md:text-display-lg text-primary tracking-tight\">Poznaj Dziubk\303\263w</h1>\n                    <p className=\"font-body-lg text-on-surface-variant max-w-2xl mt-4\">Od d\305\274ungli Amazonii po piaski Sahary \342\200\224 dzielimy si\304\231 autentycznymi emocjami, kt\303\263re spotykamy na szlaku.</p>\n                </header>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-12 gap-gutter\">\n                    {/* Magda Profile Card */}\n                    <div className=\"md:col-span-7 bg-surface-container-lowest rounded-3xl overflow-hidden shadow-sm border border-outline-variant/20 group\">\n                        <div className=\"relative h-[500px]\">\n                            <img alt=\"Magda profile\" className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAK_dCTBE4ONXrhUjXu1TzYQiENC0SQ-JwdzRrvsOGJIlQbFUOIZsbEy2022waRPkxoxl89cyE6K1pH_Cl5TjJpRXLMJB622ahBQmUgMDMcwV7O74nBTCSTlt130JE-It3hySnd-O101AwYHDCQRDOOOq31K3_XyqQ8jqQWQ2ho23wRX9LWU0vvhFTZpogg0L7LgaAXK3XEtBNJgrChRj6xpuHVt-a26fnQD9-MFsl4Z_ZikvplBV_xM_z3fQS25Etuz2GbNzw3urg\"/>\n                            <div className=\"absolute inset-0 bg-gradient-to-t from-jungle-deep/80 via-transparent to-transparent\"></div>\n                            <div className=\"absolute bottom-8 left-8 text-white\">\n                                <h2 className=\"font-headline-lg text-headline-lg-mobile md:text-headline-lg\">Magda</h2>\n                                <p className=\"font-label-sm text-secondary-fixed uppercase tracking-widest mt-2\">Fotografka i Dusza Przygody</p>\n                            </div>\n                        </div>\n                        <div className=\"p-8\">\n                            <p className=\"font-body-lg text-on-surface-variant leading-relaxed\">\n                                Magda to serce dziubki_explore. Jej oko do detali pozwala uchwyci\304\207 ulotne momenty, kt\303\263re inni pomijaj\304\205. Z aparatem w r\304\231ku przemierzy\305\202a setki kilometr\303\263w, zawsze szukaj\304\205c autentycznych historii w oczach napotkanych ludzi.\n                            </p>\n                            <div className=\"grid grid-cols-2 gap-4 mt-8\">\n                                <div className=\"bg-surface-container p-4 rounded-2xl flex flex-col items-center\">\n                                    <span className=\"font-display-lg text-headline-md text-leaf-green\">140k</span>\n                                    <span className=\"font-label-sm text-outline uppercase\">Zdj\304\231\304\207</span>\n                                </div>\n                                <div className=\"bg-surface-container p-4 rounded-2xl flex flex-col items-center\">\n                                    <span className=\"font-display-lg text-headline-md text-leaf-green\">42</span>\n                                    <span className=\"font-label-sm text-outline uppercase\">Kraje</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    {/* Stats & Quick Look */}\n                    <div className=\"md:col-span-5 flex flex-col gap-gutter\">\n                        <div className=\"bg-jungle-deep text-secondary-fixed p-8 rounded-3xl flex-1 relative overflow-hidden\">\n                            <span className=\"material-symbols-outlined absolute -right-4 -bottom-4 text-[120px] opacity-10\">public</span>\n                            <h3 className=\"font-headline-md mb-6\">Wsp\303\263lne Statystyki</h3>\n                            <div className=\"space-y-6\">\n                                <div>\n                                    <div className=\"flex justify-between mb-2\">\n                                        <span className=\"font-label-sm\">PRZEJECHANE KILOMETRY</span>\n                                        <span className=\"font-label-sm\">85,400 km</span>\n                                    </div>\n                                    <div className=\"w-full h-4 bg-primary-container rounded-full overflow-hidden\">\n                                        <div className=\"h-full bg-leaf-green w-[85%] rounded-full\"></div>\n                                    </div>\n                                </div>\n                                <div>\n                                    <div className=\"flex justify-between mb-2\">\n                                        <span className=\"font-label-sm\">NOCE POD NAMIOTEM</span>\n                                        <span className=\"font-label-sm\">1,240</span>\n                                    </div>\n                                    <div className=\"w-full h-4 bg-primary-container rounded-full overflow-hidden\">\n                                        <div className=\"h-full bg-coral-sunrise w-[92%] rounded-full\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div className=\"mt-12 flex items-center gap-4\">\n                                <div className=\"p-3 bg-leaf-green/20 rounded-full\">\n                                    <span className=\"material-symbols-outlined text-coral-sunrise\">military_tech</span>\n                                </div>\n                                <p className=\"font-body-md text-secondary-fixed-dim\">Wyr\303\263\305\274nienie Travelery 2023 za reporta\305\274 z Amazonii</p>\n                            </div>\n                        </div>\n\n                        <div className=\"bg-surface-container-high p-8 rounded-3xl\">\n                            <h3 className=\"font-headline-md text-primary mb-4\">Nasza Misja</h3>\n                            <p className=\"font-body-md text-on-surface-variant italic\">\n                                \"Wierzymy, \305\274e podr\303\263\305\274owanie to nie kolekcjonowanie piecz\304\205tek w paszporcie, ale zrozumienie r\303\263\305\274norodno\305\233ci \305\233wiata przez wsp\303\263lne posi\305\202ki, trudne wspinaczki i cisz\304\231 dzikiej natury.\"\n                            </p>\n                        </div>\n                    </div>\n\n                    {/* Mateusz Profile Card */}\n                    <div className=\"md:col-span-12 lg:col-span-8 bg-surface-container-lowest rounded-3xl overflow-hidden shadow-sm border border-outline-variant/20 flex flex-col md:flex-row group\">\n                        <div className=\"md:w-1/2 relative h-[400px] md:h-auto overflow-hidden\">\n                            <img alt=\"Mateusz profile\" className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBbbKpSFFtA8VVunT-T_jIopDD9AIsMHrapnkvNiYJ_znuueLV6UZxmsUNcsllgikxDpg5ZkWPxFj66GlGjQRuhgocIciUn7fXrveKGs2hOzlZQ0zB6PWQgrQ2C4-NC8Yfi2Eq9BFFagp3-lQr8o0vBh81fwK-aO2sTlLVRSb1dB4i7dGst_veiF6Gt3hWjjQwaKIiolqy4TdRs5kcouuL2ce-FFPaCC1SQHdyp6dVDt51PTtn_09Gwl6CBDF1wMsX7qhHR9fbHW5w\"/>\n                            <div className=\"absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-surface-container-lowest/20\"></div>\n                        </div>\n                        <div className=\"md:w-1/2 p-8 flex flex-col justify-center\">\n                            <span className=\"bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-lg font-label-sm inline-block w-fit mb-4\">LOGISTYKA I SURVIVAL</span>\n                            <h2 className=\"font-headline-lg text-primary\">Mateusz</h2>\n                            <p className=\"mt-4 font-body-lg text-on-surface-variant leading-relaxed\">\n                                In\305\274ynier z wykszta\305\202cenia, odkrywca z wyboru. Mateusz odpowiada za wyznaczanie szlak\303\263w i bezpiecze\305\204stwo wypraw. Specjalista od trudnych warunk\303\263w i lokalnych dialekt\303\263w. Jego spok\303\263j jest kotwic\304\205 w najbardziej nieprzewidywalnych sytuacjach.\n                            </p>\n                            <div className=\"mt-8 space-y-4\">\n                                <div className=\"flex items-center gap-4\">\n                                    <span className=\"material-symbols-outlined text-leaf-green\">terrain</span>\n                                    <span className=\"font-body-md text-on-surface\">Zdobyte szczyty: 12 (powy\305\274ej 5000m)</span>\n                                </div>\n                                <div className=\"flex items-center gap-4\">\n                                    <span className=\"material-symbols-outlined text-leaf-green\">directions_run</span>\n                                    <span className=\"font-body-md text-on-surface\">Przebyte pieszo: 12,500 km</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    {/* Call to Action Card */}\n                    <div className=\"md:col-span-12 lg:col-span-4 bg-coral-sunrise p-10 rounded-3xl text-white flex flex-col justify-between coral-glow relative overflow-hidden group\">\n                        <div className=\"absolute -top-12 -right-12 opacity-10\">\n                            <span className=\"material-symbols-outlined text-[200px] rotate-12\">explore</span>\n                        </div>\n                        <div className=\"relative z-10\">\n                            <h3 className=\"font-headline-lg mb-4\">\305\232led\305\272 Nasz\304\205 Tras\304\231</h3>\n                            <p className=\"font-body-md opacity-90 mb-8\">B\304\205d\305\272 cz\304\231\305\233ci\304\205 naszej spo\305\202eczno\305\233ci i otrzymuj powiadomienia o nowych wyprawach oraz relacjach na \305\274ywo z najdalszych zak\304\205tk\303\263w \305\233wiata.</p>\n                        </div>\n                        <button className=\"relative z-10 bg-white text-coral-sunrise w-full py-4 rounded-full font-label-sm font-bold uppercase tracking-widest hover:bg-jungle-deep hover:text-white transition-all duration-300 transform group-hover:scale-105 active:scale-95 shadow-lg\">\n                            DO\305\201\304\204CZ DO NAS\n                        </button>\n                    </div>\n                </div>\n            </main>\n\n            {/* BottomNavBar */}\n            <nav className=\"md:hidden fixed bottom-0 left-0 w-full flex justify-around items-center h-16 px-4 z-50 bg-surface/95 dark:bg-surface-container-highest/95 backdrop-blur-lg border-t border-outline-variant/20 shadow-[0_-4px_10px_rgba(0,0,0,0.05)] rounded-t-xl\">\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform active:scale-90 duration-200\">\n                    <span className=\"material-symbols-outlined\">explore</span>\n                    <span className=\"font-label-sm text-label-sm\">Mapa</span>\n                </a>\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'gallery\'); }} className=\"cursor-pointer flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform active:scale-90 duration-200\">\n                    <span className=\"material-symbols-outlined\">photo_library</span>\n                    <span className=\"font-label-sm text-label-sm\">Galeria</span>\n                </a>\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'live\'); }} className=\"cursor-pointer flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform active:scale-90 duration-200\">\n                    <span className=\"material-symbols-outlined\">sensors</span>\n                    <span className=\"font-label-sm text-label-sm\">Live Stream</span>\n                </a>\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'profiles\'); }} className=\"cursor-pointer flex flex-col items-center justify-center bg-secondary-container text-on-secondary-container rounded-full px-5 py-1 shadow-[0_0_15px_rgba(255,127,80,0.3)] scale-110 active:scale-90 duration-200\">\n                    <span className=\"material-symbols-outlined\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>person</span>\n                    <span className=\"font-label-sm text-label-sm\">Profil</span>\n                </a>\n            </nav>\n        </div>\n    );\n}"
