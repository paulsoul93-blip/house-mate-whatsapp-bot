      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\nimport { useState } from \'react\';\nimport LandingScreen from \'./screens/LandingScreen\';\nimport DashboardScreen from \'./screens/DashboardScreen\';\nimport GalleryScreen from \'./screens/GalleryScreen\';\nimport ProfileScreen from \'./screens/ProfileScreen\';\nimport LiveStreamScreen from \'./screens/LiveStreamScreen\';\n\nexport type ScreenType = \'landing\' | \'dashboard\' | \'gallery\' | \'profiles\' | \'live\';\n\nexport default function App() {\n  const [currentScreen, setCurrentScreen] = useState<ScreenType>(\'landing\');\n\n  return (\n    <div className=\"min-h-screen font-body-md text-on-surface bg-background antialiased relative\">\n      {currentScreen === \'landing\' && <LandingScreen onNavigate={setCurrentScreen} />}\n      {currentScreen === \'dashboard\' && <DashboardScreen onNavigate={setCurrentScreen} />}\n      {currentScreen === \'gallery\' && <GalleryScreen onNavigate={setCurrentScreen} />}\n      {currentScreen === \'profiles\' && <ProfileScreen onNavigate={setCurrentScreen} />}\n      {currentScreen === \'live\' && <LiveStreamScreen onNavigate={setCurrentScreen} />}\n    </div>\n  );\n}"
    }
