      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHRCOZq_FdNsY9TJJLpTO8vQwnF5gTP4Ow4qVb2CD7CN4dYjIf7mHxmZKDaOc35hHTBIL3AOuWXDjB_-p0gpz2QZsImATA2kNZt7QOVE08iSehE_8DK13ZYB4h_Q214DqeCpqpbjvYA87jlEF9kf06eLmZUsqLZio-DxzbJiHxfqS-EEA9i"
