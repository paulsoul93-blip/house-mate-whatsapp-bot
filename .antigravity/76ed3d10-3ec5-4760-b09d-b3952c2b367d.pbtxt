vigate(\'live\'); }} className=\\\\\\\"flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform active:scale-90 duration-200\\\\\\\">\\\\n                    <span className=\\\\\\\"material-symbols-outlined\\\\\\\">sensors</span>\\\\n                    <span className=\\\\\\\"font-label-sm text-label-sm\\\\\\\">Live</span>\\\\n                </a>\\\\n                <a onClick={(e) => { e.preventDefault(); onNavigate(\'profiles\'); }} className=\\\\\\\"flex flex-col items-center justify-center text-on-surface-variant hover:text-leaf-green transition-transform active:scale-90 duration-200\\\\\\\">\\\\n                    <span className=\\\\\\\"material-symbols-outlined\\\\\\\">person</span>\\\\n                    <span className=\\\\\\\"font-label-sm text-label-sm\\\\\\\">Profil</span>\\\\n                </a>\\\\n            </nav>\\\\n        </div>\\\\n    );\\\\n}\\\",\\\"TargetFile\\\":\\\"/src/screens/DashboardScreen.tsx\\\",\\\"toolAction\\\":\\\"Generating Dashboard layout from HTML 1\\\",\\\"toolSummary\\\":\\\"Create DashboardScreen Component\\\"}\"\n}"
