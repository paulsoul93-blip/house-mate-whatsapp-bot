    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { ScreenType } from \'../App\';\n\nexport default function LandingScreen({ onNavigate }: { onNavigate: (screen: ScreenType) => void }) {\n    const [scrolled, setScrolled] = useState(false);\n\n    useEffect(() => {\n        const animateStats = () => {\n            const stats = document.querySelectorAll(\'.stat-count\');\n            stats.forEach(stat => {\n                const target = parseInt(stat.getAttribute(\'data-target\') || \'0\');\n                let current = 0;\n                const increment = target / 50; \n                const updateCount = () => {\n                    if (current < target) {\n                        current += increment;\n                        stat.innerHTML = Math.ceil(current).toLocaleString() + (target > 1000 ? \'+\' : \'\');\n                        setTimeout(updateCount, 20);\n                    } else {\n                        stat.innerHTML = target.toLocaleString() + (target > 1000 ? \'+\' : \'\');\n                    }\n                };\n                updateCount();\n            });\n        };\n        setTimeout(animateStats, 100);\n\n        const handleScroll = () => {\n            setScrolled(window.scrollY > 100);\n        };\n        window.addEventListener(\'scroll\', handleScroll);\n        return () => window.removeEventListener(\'scroll\', handleScroll);\n    }, []);\n\n    return (\n        <div className=\"tropical-bg relative\">\n            {/* Decorative Background Elements */}\n            <div className=\"fixed inset-0 z-[0] pointer-events-none overflow-hidden\">\n                <div className=\"absolute top-[-10%] right-[-5%] w-[50vw] h-[50vw] rounded-full bg-primary-fixed/20 blur-[120px]\"></div>\n                <div className=\"absolute bottom-[-10%] left-[-5%] w-[60vw] h-[60vw] rounded-full bg-secondary-fixed/20 blur-[150px]\"></div>\n            </div>\n\n            {/* TopNavBar */}\n            <header className={`fixed top-0 left-0 right-0 z-50 backdrop-blur-xl shadow-sm border-b border-white/20 transition-all duration-300 ${scrolled ? \'py-2 bg-surface/90\' : \'py-4 bg-surface/80 dark:bg-primary/90\'}`}>\n                <nav className=\"flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto\">\n                    <div \n                        className=\"font-headline-md text-headline-md font-bold text-primary dark:text-secondary-fixed cursor-pointer\"\n                        onClick={() => onNavigate(\'landing\')}\n                    >\n                        dziubki_explore\n                    </div>\n                    <div className=\"hidden md:flex gap-8 items-center relative z-10\">\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'landing\'); }} className=\"cursor-pointer font-body-md text-body-md text-primary dark:text-secondary-fixed border-b-2 border-secondary font-bold pb-1 transition-colors duration-200\">Mapa</a>\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'gallery\'); }} className=\"cursor-pointer font-body-md text-body-md text-on-surface-variant dark:text-surface-variant hover:text-secondary transition-colors duration-200\">Galeria</a>\n                        <a onClick={(e) => { e.preventDefault(); onNavigate(\'live\'); }} className=\"cursor-pointer font-body-md text-body-md text-on-surface-variant dark:text-surface-variant hover:text-secondary transition-colors duration-200\">Live Stream</a>\n                    </div>\n                    <button \n                        onClick={() => onNavigate(\'dashboard\')}\n                        className=\"bg-coral-sunrise text-white px-6 py-2 rounded-full font-bold uppercase coral-glow hover:opacity-90 active:scale-95 transition-all shadow-lg relative z-10\"\n                    >\n                        Creator Studio\n                    </button>\n                </nav>\n            </header>\n\n            {/* Hero Section */}\n            <section className=\"relative h-screen flex items-center justify-center overflow-hidden\">\n                <div className=\"absolute inset-0 z-0\">\n                    <img alt=\"Magda and Mateusz Tropical Hero\" className=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAlut5ebs9y3j34pURaxk4xraYkI1mPV1PsCZT1zC9O09FJtOCYKgKSOow2w5R4caGhEdfdBEGbIpJ6rFRmks-n386pSr6vFPX3k-Syf7jkjH4N1MGDrFOMqLbTrzcGCrLmFX-Hvaug_rdjH34R3ugDyt2y_MSwKex5cJZdXb4KSfJVnf6H-rz7tX51MpsgkymJRsnTK5EjecP8RflvKyagKtFIdtnKx26S2dScZlYmC3q5EvXU8gOeN_7cOV1cwgz9GOlv6sKm2RU\"/>\n                    <div className=\"absolute inset-0 bg-gradient-to-b from-primary/50 via-primary/30 to-surface/90\"></div>\n                </div>\n                <div className=\"relative z-10 text-center px-margin-mobile\">\n                    <div className=\"hero-glass p-8 md:p-14 rounded-[40px] max-w-4xl mx-auto shadow-2xl\">\n                        <span className=\"inline-block bg-white/20 backdrop-blur-md text-secondary-fixed border border-white/30 px-6 py-2 rounded-full text-label-sm uppercase tracking-widest mb-8 shadow-sm\">Explore the Wild</span>\n                        <h1 className=\"font-display-lg text-display-lg text-white drop-shadow-xl mb-6\">dziubki_explore</h1>\n                        <p className=\"text-white/95 font-body-lg text-body-lg max-w-2xl mx-auto mb-10 text-lg md:text-xl drop-shadow-md\">Autentyczno\305\233\304\207, adrenalina i niezapomniane momenty z najdalszych zak\304\205tk\303\263w \305\233wiata. Do\305\202\304\205cz do naszej wyprawy.</p>\n                        <div className=\"flex flex-col md:flex-row gap-6 justify-center\">\n                            <button className=\"bg-coral-sunrise text-white px-10 py-4 rounded-full font-bold uppercase coral-glow hover:scale-105 transition-all duration-300 flex items-center justify-center gap-3 shadow-[0_15px_30px_-10px_rgba(255,127,80,0.5)]\">\n                                <span className=\"material-symbols-outlined\">explore</span> Start Przygody\n                            </button>\n                            <button onClick={() => onNavigate(\'live\')} className=\"bg-error text-white px-10 py-4 rounded-full font-bold uppercase pulse-live hover:scale-105 transition-all duration-300 flex items-center justify-center gap-3 shadow-lg\">\n                                <span className=\"material-symbols-outlined\">play_circle</span> Ogl\304\205daj Live\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce\">\n                    <span className=\"material-symbols-outlined text-white text-4xl drop-shadow-md\">expand_more</span>\n                </div>\n            </section>\n\n            <main className=\"max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap space-y-32 relative z-10\">\n                {/* Animated Poll */}\n                <section className=\"glass-panel rounded-[40px] p-8 md:p-14 relative overflow-hidden\">\n                    <div className=\"absolute top-[-20%] right-[-10%] p-8 opacity-[0.03] pointer-events-none\">\n                        <span className=\"material-symbols-outlined text-[400px]\">travel_explore</span>\n                    </div>\n                    <div className=\"relative z-10 max-w-3xl mx-auto\">\n                        <div className=\"text-center mb-10\">\n                            <h2 className=\"font-headline-lg text-headline-lg text-primary mb-4\">Gdzie uderzamy dalej?</h2>\n                            <p className=\"font-body-lg text-on-surface-variant text-lg\">Twoja decyzja kszta\305\202tuje nasz\304\205 kolejn\304\205 wypraw\304\231. G\305\202osuj!</p>\n                        </div>\n                        <div className=\"space-y-5\">\n                            <div className=\"group cursor-pointer bg-white rounded-2xl p-5 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:border-secondary/40 transition-all duration-300 relative overflow-hidden\">\n                                <div className=\"absolute inset-0 bg-secondary/5 opacity-0 group-hover:opacity-100 transition-opacity\"></div>\n                                <div className=\"relative flex items-center justify-between mb-4\">\n                                    <span className=\"font-bold text-lg flex items-center gap-4 text-primary\"><div className=\"w-10 h-10 rounded-full bg-secondary-fixed/50 flex items-center justify-center text-secondary\"><span className=\"material-symbols-outlined\">beach_access</span></div> Bali, Indonezja</span>\n                                    <span className=\"text-secondary font-bold text-xl\">42%</span>\n                                </div>\n                                <div className=\"w-full bg-surface-container h-3 rounded-full overflow-hidden shadow-inner\">\n                                    <div className=\"bg-gradient-to-r from-secondary to-surface-tint h-full rounded-full transition-all duration-1000 w-[42%] group-hover:brightness-110 relative overflow-hidden\">\n                                        <div className=\"absolute inset-0 bg-white/20 w-full h-full transform -skew-x-12 -translate-x-full group-hover:animate-[shimmer_2s_infinite]\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            <div className=\"group cursor-pointer bg-white rounded-2xl p-5 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:border-secondary/40 transition-all duration-300 relative overflow-hidden\">\n                                <div className=\"absolute inset-0 bg-secondary/5 opacity-0 group-hover:opacity-100 transition-opacity\"></div>\n                                <div className=\"relative flex items-center justify-between mb-4\">\n                                    <span className=\"font-bold text-lg flex items-center gap-4 text-primary\"><div className=\"w-10 h-10 rounded-full bg-secondary-fixed/50 flex items-center justify-center text-secondary\"><span className=\"material-symbols-outlined\">forest</span></div> Amazonia, Brazylia</span>\n                                    <span className=\"text-secondary font-bold text-xl\">28%</span>\n                                </div>\n                                <div className=\"w-full bg-surface-container h-3 rounded-full overflow-hidden shadow-inner\">\n                                    <div className=\"bg-gradient-to-r from-secondary to-surface-tint h-full rounded-full transition-all duration-1000 w-[28%] group-hover:brightness-110 relative overflow-hidden\"></div>\n                                </div>\n                            </div>\n\n                            <div className=\"group cursor-pointer bg-white rounded-2xl p-5 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:border-secondary/40 transition-all duration-300 relative overflow-hidden\">\n                                <div className=\"absolute inset-0 bg-secondary/5 opacity-0 group-hover:opacity-100 transition-opacity\"></div>\n                                <div className=\"relative flex items-center justify-between mb-4\">\n                                    <span className=\"font-bold text-lg flex items-center gap-4 text-primary\"><div className=\"w-10 h-10 rounded-full bg-secondary-fixed/50 flex items-center justify-center text-secondary\"><span className=\"material-symbols-outlined\">temple_buddhist</span></div> Tajlandia</span>\n                                    <span className=\"text-secondary font-bold text-xl\">30%</span>\n                                </div>\n                                <div className=\"w-full bg-surface-container h-3 rounded-full overflow-hidden shadow-inner\">\n                                    <div className=\"bg-gradient-to-r from-secondary to-surface-tint h-full rounded-full transition-all duration-1000 w-[30%] group-hover:brightness-110 relative overflow-hidden\"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                {/* Travel Map & Stats */}\n                <section className=\"grid md:grid-cols-3 gap-8 items-start\">\n                    <div className=\"md:col-span-2 rounded-[40px] overflow-hidden shadow-2xl relative h-[500px] bg-[#022c22] map-3d-effect border-4 border-white/20\">\n                        <img alt=\"High-tech 3D Travel Map\" className=\"w-full h-full object-cover opacity-60 mix-blend-luminosity brightness-75 drop-shadow-xl\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBI2Tg9OMbQlPeAsrmucG5lXNcC96HVsllwfUVUL1_hSzxBNSKP4tQ6Bfq3sDf6gJ1Av7cfNh3boDcRGRQz0fYVxwusHioHWP9-t2aFdyeQ67hInZwYgsdOfICgdFk9Kbn9nH95L5AQrmahqzYYVpNSTFwWZhWXe1uw0ZJTfBjx6YsmNuZ0odG_Uae6a3nUElR0BZ4eiWSvE4tH_hhsC2tTaeOs80YPMMuASjH8AIOBPqOoyYpUvXN47bXFY0BB46HWyYn-ajD0BA0\"/>\n                        <div className=\"absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent\"></div>\n                        <div className=\"absolute top-[45%] left-[65%] -translate-x-1/2 -translate-y-1/2\">\n                            <div className=\"map-ring absolute w-24 h-24 bg-coral-sunrise/40 rounded-full -m-10\"></div>\n                            <div className=\"map-ring absolute w-24 h-24 bg-coral-sunrise/30 rounded-full -m-10\" style={{ animationDelay: \'0.5s\' }}></div>\n                            <div className=\"w-4 h-4 bg-coral-sunrise rounded-full relative z-10 border-2 border-white shadow-[0_0_15px_rgba(255,127,80,1)]\"></div>\n                        </div>\n                        <div className=\"absolute bottom-8 left-8 bg-black/40 backdrop-blur-xl p-5 rounded-3xl border border-white/20 shadow-2xl text-white\">\n                            <p className=\"font-label-sm uppercase text-secondary-fixed tracking-widest mb-1\">Obecna lokacja</p>\n                            <p className=\"font-headline-md text-xl\">Ubud, Bali</p>\n                        </div>\n                        <div className=\"absolute top-8 right-8 flex flex-col gap-4\">\n                            <div className=\"w-10 h-10 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center text-white border border-white/20\"><span className=\"material-symbols-outlined text-sm\">add</span></div>\n                            <div className=\"w-10 h-10 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center text-white border border-white/20\"><span className=\"material-symbols-outlined text-sm\">remove</span></div>\n                            <div className=\"w-10 h-10 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center text-white border border-white/20\"><span className=\"material-symbols-outlined text-sm\">my_location</span></div>\n                        </div>\n                    </div>\n                    \n                    <div className=\"flex flex-col justify-between gap-6 h-full\">\n                        <div className=\"bg-gradient-to-br from-primary to-primary-container text-white p-8 rounded-[40px] flex items-center justify-between shadow-2xl border border-white/10 relative overflow-hidden group hover:scale-[1.02] transition-transform flex-1\">\n                            <div className=\"absolute right-0 top-0 w-32 h-32 bg-white/5 rounded-full blur-2xl group-hover:bg-white/10 transition-colors\"></div>\n                            <div className=\"relative z-10\">\n                                <p className=\"font-label-sm uppercase opacity-80 tracking-widest mb-2\">Kilometry</p>\n                                <p className=\"text-headline-md text-4xl font-bold stat-count\" data-target=\"12450\">0</p>\n                            </div>\n                            <span className=\"material-symbols-outlined text-secondary-fixed text-5xl relative z-10\">route</span>\n                        </div>\n                        <div className=\"bg-gradient-to-br from-secondary to-surface-tint text-white p-8 rounded-[40px] flex items-center justify-between shadow-2xl border border-white/10 relative overflow-hidden group hover:scale-[1.02] transition-transform flex-1\">\n                            <div className=\"absolute right-0 top-0 w-32 h-32 bg-white/5 rounded-full blur-2xl group-hover:bg-white/10 transition-colors\"></div>\n                            <div className=\"relative z-10\">\n                                <p className=\"font-label-sm uppercase opacity-80 tracking-widest mb-2\">Zdobyte kraje</p>\n                                <p className=\"text-headline-md text-4xl font-bold stat-count\" data-target=\"18\">0</p>\n                            </div>\n                            <span className=\"material-symbols-outlined text-primary-fixed text-5xl relative z-10\">public</span>\n                        </div>\n                        <div className=\"bg-gradient-to-br from-coral-sunrise to-[#ff6b3d] text-white p-8 rounded-[40px] flex items-center justify-between shadow-2xl border border-white/20 coral-glow relative overflow-hidden group hover:scale-[1.02] transition-transform flex-1\">\n                            <div className=\"absolute right-0 top-0 w-32 h-32 bg-white/10 rounded-full blur-2xl group-hover:bg-white/20 transition-colors\"></div>\n                            <div className=\"relative z-10\">\n                                <p className=\"font-label-sm uppercase opacity-90 tracking-widest mb-2\">Przygody</p>\n                                <p className=\"text-headline-md text-4xl font-bold\">Infinite</p>\n                            </div>\n                            <span className=\"material-symbols-outlined text-white text-5xl relative z-10\">auto_awesome</span>\n                        </div>\n                    </div>\n                </section>\n\n                {/* Galleries: Bento Grid */}\n                <section>\n                    <div className=\"flex justify-between items-end mb-12\">\n                        <div>\n                            <span className=\"font-label-sm text-secondary uppercase tracking-widest mb-2 block\">Wspomnienia</span>\n                            <h2 className=\"font-headline-lg text-headline-lg text-primary\">Darmowe Momenty</h2>\n                        </div>\n                        <button onClick={() => onNavigate(\'gallery\')} className=\"text-primary font-bold flex items-center gap-2 hover:translate-x-2 transition-transform bg-white/50 px-6 py-3 rounded-full border border-outline-variant/30 shadow-sm backdrop-blur-sm cursor-pointer\">\n                            Zobacz wszystko <span className=\"material-symbols-outlined\">arrow_forward</span>\n                        </button>\n                    </div>\n                    <div className=\"grid grid-cols-2 md:grid-cols-4 gap-6 md:auto-rows-[320px]\">\n                        <div onClick={() => onNavigate(\'gallery\')} className=\"cursor-pointer col-span-2 row-span-2 rounded-[40px] overflow-hidden group shadow-2xl relative\">\n                            <img alt=\"Travel moment 1\" className=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAX4qLHQRkmB6pA0h3qCVZfg2aOIXg81nC8AQ9bxaxUQ2nAzQS7ptG6lXyUFDNwntM0Hbu3r8gq6Il3o-IerAXmFgMHINUP4Q6oiF9_302cSO5b15G7aPA1Uv_9qNHT0kTpxVGKEGUBbtYeasa_CR5AcrYpAcs8ddwYtPpwYcoLIscS9ZuzEsFgR3rfCq_Tt7KpG4kMDPsJrSh9zAWygoIklWqq2ijsfDZeJseO_bwvbwni2Qlh45aPhPfnYhVkI3Q6bJszA7fMtBU\"/>\n                        </div>\n                        <div onClick={() => onNavigate(\'gallery\')} className=\"cursor-pointer rounded-[40px] overflow-hidden group shadow-2xl relative\">\n                            <img alt=\"Travel moment 2\" className=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAsKl7zooHm3LkldmFD30IU3FPw4IaHHuk66uvAtYF9SorG9MijFAFx9xY32iVioFDU4BNYUMDCI76_cevyUWt7gMSEn0aPR6WQ5wQnVz5KUhCpmVuKAA7yAN1RWCevPN37rhhCiWKeUCZyQ2UW8hKi_u2h-z9oKO0hGJvnHfXWxD1U2HYXsOrbsB-TNmfwzGz1hYIn39LzlDLzqkIDlJ0HrP9h3A_7o06EH0OGWOPVoYKG0hVIEoMrURxBvMk7aXWyzNitWdGfeck\"/>\n                        </div>\n                        <div onClick={() => onNavigate(\'gallery\')} className=\"cursor-pointer rounded-[40px] overflow-hidden group shadow-2xl relative\">\n                            <img alt=\"Travel moment 3\" className=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBSEkAgkvgQqRCOMspkN9nOOXbYR0XPtd2Mej1vMhYX-_InKplhUlGT3x4srhITN3H7opuMYaCGAIciShazM5NNznqab518x6RpUYjl5i-aoBmEBHse0QbHKoa10bsJ1rraITwk3ebirrhkqCOJhrXgST4M83LPszKM8RCT_sgDr0DU4vsPmKicuAPI0xPzsM1gl41WKmKi8A7gQfD_XTi6MWOOmS9jBhOFrKcIZnaIgDniharm_qPEXoLe_oKq_xtQpDFhs2Skia0\"/>\n                        </div>\n                        <div className=\"col-span-2 rounded-[40px] overflow-hidden group relative shadow-2xl border border-white/20\">\n                            <img alt=\"Premium Preview\" className=\"w-full h-full object-cover blur-[4px] transition-transform duration-1000 group-hover:scale-110 scale-105\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAm_LcQcPLRMlfahLnA6EidRJ1RcPCCWx6Kvu4YNILBTYmp2KGpdai84vtpuXSkbk0Tym0xrFviJQcv-QxpsQtha4fkrSTVnM3DSHh3HCQXigWS2kYe2yBmZYDmHQDNvk8R69_HCs6MXIoMmVXJjmpkBidYtd4RIvKJWc1uhfa5pi_WBZMCwZg0gOjAYM2oIgEY8L9LkNmyOtT8Iq-iN7PU3zfK5xoaOKRls3VdJLu56vwln8xcRfS4qh_C2J9SWmHlq8-f1fcQeRM\"/>\n                            <div className=\"absolute inset-0 bg-primary/60 backdrop-blur-md flex flex-col items-center justify-center text-white p-8\">\n                                <div className=\"w-16 h-16 bg-white/10 rounded-full flex items-center justify-center mb-6 border border-white/20 shadow-lg\">\n                                    <span className=\"material-symbols-outlined text-3xl\">lock</span>\n                                </div>\n                                <h3 className=\"font-headline-md text-2xl font-bold mb-3\">Premium Actions</h3>\n                                <p className=\"text-center text-base opacity-90 mb-6 max-w-sm\">Odblokuj najmocniejsze akcje z naszych wypraw!</p>\n                                <button className=\"bg-white text-primary px-8 py-3 rounded-full font-bold text-sm hover:bg-coral-sunrise hover:text-white hover:shadow-[0_0_20px_rgba(255,127,80,0.5)] transition-all duration-300\">Odblokuj dost\304\231p</button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                {/* Golden Thoughts */}\n                <section className=\"relative bg-gradient-to-br from-primary to-[#013824] text-white rounded-[60px] p-12 md:p-24 overflow-hidden shadow-2xl border border-white/10\">\n                    <div className=\"absolute top-0 right-0 p-12 opacity-5 pointer-events-none mix-blend-overlay\">\n                        <span className=\"material-symbols-outlined text-[400px]\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>format_quote</span>\n                    </div>\n                    <div className=\"relative z-10 max-w-4xl mx-auto text-center\">\n                        <span className=\"inline-block bg-white/10 backdrop-blur-md border border-white/20 text-secondary-fixed px-6 py-2 rounded-full text-label-sm uppercase tracking-widest mb-10 shadow-lg\">Z\305\202ote My\305\233li Matiego</span>\n                        <p className=\"font-display-lg text-headline-lg md:text-[56px] leading-[1.1] mb-16 italic drop-shadow-lg text-white/95\">\n                            \"widzisz duszek \305\202\304\205czysz przyjemne z po\305\274ytecznym, a nie jeste\305\233 ginekologiem hehe\"\n                        </p>\n                        <div className=\"flex items-center justify-center gap-6\">\n                            <div className=\"w-16 h-[2px] bg-gradient-to-r from-transparent to-secondary-fixed\"></div>\n                            <p className=\"font-bold uppercase tracking-[0.2em] text-secondary-fixed text-lg\">Mateusz Dziubek</p>\n                            <div className=\"w-16 h-[2px] bg-gradient-to-l from-transparent to-secondary-fixed\"></div>\n                        </div>\n                    </div>\n                </section>\n\n                {/* Creators\' Profiles */}\n                <section className=\"grid md:grid-cols-2 gap-12\">\n                    <a onClick={(e) => { e.preventDefault(); onNavigate(\'profiles\'); }} className=\"group relative block cursor-pointer transition-all duration-500\">\n                        <div className=\"aspect-[4/5] rounded-[60px] overflow-hidden shadow-2xl transition-all duration-500 group-hover:-translate-y-4 border border-outline-variant/20\">\n                            <img alt=\"Magda Profile\" className=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAK_dCTBE4ONXrhUjXu1TzYQiENC0SQ-JwdzRrvsOGJIlQbFUOIZsbEy2022waRPkxoxl89cyE6K1pH_Cl5TjJpRXLMJB622ahBQmUgMDMcwV7O74nBTCSTlt130JE-It3hySnd-O101AwYHDCQRDOOOq31K3_XyqQ8jqQWQ2ho23wRX9LWU0vvhFTZpogg0L7LgaAXK3XEtBNJgrChRj6xpuHVt-a26fnQD9-MFsl4Z_ZikvplBV_xM_z3fQS25Etuz2GbNzw3urg\"/>\n                            <div className=\"absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-14\">\n                                <h3 className=\"text-white font-headline-lg text-5xl mb-2\">Magda</h3>\n                                <p className=\"text-secondary-fixed font-body-lg text-lg mb-6 opacity-90\">Mistrzyni logistyki i spontanicznych ta\305\204c\303\263w na pla\305\274y.</p>\n                                <div className=\"flex gap-4\">\n                                    <div className=\"w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/30\"><span className=\"material-symbols-outlined text-white\">camera_alt</span></div>\n                                    <div className=\"w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/30\"><span className=\"material-symbols-outlined text-white\">flight_takeoff</span></div>\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"mt-8 flex items-center justify-between px-4\">\n                            <h3 className=\"font-headline-md text-3xl text-primary font-bold\">Magda</h3>\n                            <div className=\"w-12 h-12 rounded-full bg-white shadow-md flex items-center justify-center border border-outline-variant/20 group-hover:bg-secondary group-hover:text-white transition-colors duration-300\">\n                                <span className=\"material-symbols-outlined text-2xl group-hover:rotate-45 transition-transform duration-300\">arrow_outward</span>\n                            </div>\n                        </div>\n                    </a>\n                    \n                    <a onClick={(e) => { e.preventDefault(); onNavigate(\'profiles\'); }} className=\"group relative block cursor-pointer transition-all duration-500\">\n                        <div className=\"aspect-[4/5] rounded-[60px] overflow-hidden shadow-2xl transition-all duration-500 group-hover:-translate-y-4 border border-outline-variant/20\">\n                            <img alt=\"Mateusz Profile\" className=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBbbKpSFFtA8VVunT-T_jIopDD9AIsMHrapnkvNiYJ_znuueLV6UZxmsUNcsllgikxDpg5ZkWPxFj66GlGjQRuhgocIciUn7fXrveKGs2hOzlZQ0zB6PWQgrQ2C4-NC8Yfi2Eq9BFFagp3-lQr8o0vBh81fwK-aO2sTlLVRSb1dB4i7dGst_veiF6Gt3hWjjQwaKIiolqy4TdRs5kcouuL2ce-FFPaCC1SQHdyp6dVDt51PTtn_09Gwl6CBDF1wMsX7qhHR9fbHW5w\"/>\n                            <div className=\"absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-14\">\n                                <h3 className=\"text-white font-headline-lg text-5xl mb-2\">Mateusz</h3>\n                                <p className=\"text-secondary-fixed font-body-lg text-lg mb-6 opacity-90\">Cz\305\202owiek od z\305\202otych my\305\233li i ekstremalnych wyzwa\305\204.</p>\n                                <div className=\"flex gap-4\">\n                                    <div className=\"w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/30\"><span className=\"material-symbols-outlined text-white\">fitness_center</span></div>\n                                    <div className=\"w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/30\"><span className=\"material-symbols-outlined text-white\">mountain_flag</span></div>\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"mt-8 flex items-center justify-between px-4\">\n                            <h3 className=\"font-headline-md text-3xl text-primary font-bold\">Mateusz</h3>\n                            <div className=\"w-12 h-12 rounded-full bg-white shadow-md flex items-center justify-center border border-outline-variant/20 group-hover