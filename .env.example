# House Mate WhatsApp Bot configuration

# Local HTTP status and WhatsApp connection page
PORT=3000
HTTP_HOST="127.0.0.1"

# Must exactly match the WhatsApp group title
WA_GROUP_NAME="House Mate App"
# Exact group JID avoids ambiguity when two groups share the same title
WA_GROUP_ID=""

# Cleaning rota members in rotation order
DUTY_MEMBERS="Pawel,Merica,Ozgur,Kamil"

# Sunday 19:00 weekly handover in London time
SCHEDULE_CRON="0 19 * * 0"
SCHEDULE_TIMEZONE="Europe/London"

# Local WhatsApp session and state storage
DATA_DIR="./data"

# Household and official Huntingdonshire District Council collection calendar
HOUSE_ADDRESS="19 Silver Birch Close"
HOUSE_POSTCODE="PE29 7BW"
COUNCIL_CALENDAR_URL="https://servicelayer3c.azure-api.net/wastecalendar/calendar/ical/100090117435?authority=HDC&take=20"
COUNCIL_SOURCE_URL="https://www.huntingdonshire.gov.uk/refuse-calendar/results?uprn=100090117435"
COUNCIL_CACHE_TTL_MINUTES=360

# Change this value only when a new startup welcome should be posted once
WELCOME_VERSION="welcome-2026-08-v2"

# Optional Oracle deployment settings
ORACLE_VM_IP=""
ORACLE_VM_USER="ubuntu"
ORACLE_SSH_KEY_PATH=""
