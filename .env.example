# House Mate App WhatsApp Bot Configuration

# HTTP Status / Healthcheck Port
PORT=3000

# WhatsApp Group Name (Must match target group name exactly)
WA_GROUP_NAME="House Mate App"

# Rotation Queue Members (comma-separated, exact order)
DUTY_MEMBERS="Pawel,Merica,Ozgur,Kamil"

# Schedule (Cron format: 0 19 * * 0 = Sunday 19:00)
SCHEDULE_CRON="0 19 * * 0"
SCHEDULE_TIMEZONE="Europe/London"

# Data and Session storage directory
DATA_DIR="./data"

# Oracle Cloud VM Deployment Settings (optional, used by scripts/deploy_oracle.sh)
ORACLE_VM_IP=""
ORACLE_VM_USER="ubuntu"
ORACLE_SSH_KEY_PATH=""
